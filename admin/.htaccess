# Admin directory — PHP auth handles access control.
# This file prevents directory listing and hardens PHP settings.
Options -Indexes

# Hide PHP errors from users in production
php_flag display_errors Off
php_value error_reporting 32767
php_flag log_errors On

# Security headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Block access to config/auth source files directly (PHP still executes normally)
<FilesMatch "^(config|auth)\.php$">
    Order Allow,Deny
    Deny from all
</FilesMatch>
