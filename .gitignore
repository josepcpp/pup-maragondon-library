# ── Secrets ─────────────────────────────────────────────────────────
# Contains the admin username and bcrypt password hash. Never commit.
data/admin_credentials.json
data/login-attempts.json

# ── Local working copies ────────────────────────────────────────────
_backup_pre_rework/
*.bak
*.tmp
*.orig

# ── CMS runtime artefacts ───────────────────────────────────────────
# Persistent flock() files and tempnam() scratch files from the atomic writers
data/*.lock
data/*.tmp
data/tmp*

# Per-save content snapshots. Local editing history, not source.
data/_versions/

# ── Uploaded media ──────────────────────────────────────────────────
# Uploads are site content, managed through the CMS, not source.
assets/uploads/**
!assets/uploads/**/.gitkeep

# ── Logs & OS noise ─────────────────────────────────────────────────
*.log
error_log
php_errors.log
.DS_Store
Thumbs.db
desktop.ini

# ── Editor ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
